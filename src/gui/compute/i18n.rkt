#lang racket/base
;; i18n.rkt — 界面文字的多语言表（G6）：(t 'key 参数…) 按 current-lang 取文字，缺译退回中文，再退回键名。
;; 只管界面文字；发给模型的内容、内核协议、日志格式不翻译。语言在启动时由拼装层定一次（PI2_LANG > 系统首选语言）。
;; 新增界面文字：在 CATALOG 里加一行（两种语言都给），组件里用 (t 'key …)。tests/gui/i18n-test.rkt 检查两种语言齐全、参数个数一致。

(define LANGS '(zh en))
(define current-lang (make-parameter 'zh))

;; 系统 / 环境给的语言标签（"zh-Hans-CN"、"en-US"、"zh_CN.UTF-8"…）→ 支持的语言；不认识 → #f
(define (lang-from-tag tag)
  (cond [(not (string? tag)) #f]
        [(regexp-match? #rx"^(?i:zh)" tag) 'zh]
        [(regexp-match? #rx"^(?i:en)" tag) 'en]
        [else #f])
) ; end define lang-from-tag

