  (type! s "(bad")
  (check-false (s 'submit!))
  (type! s "^corp-[0-9]{6}$")
  (check-equal? (s 'submit!) '(add-secret-pattern "^corp-[0-9]{6}$")))

(test-case "tool output: lines / mode choices, keep / drop regex (bad regex stays), local model, per-tool rule (bad format stays), remove"
  (define s (new-sv))
  (s 'open!)
  (render s)
  (click s 'section 'tools)
  (render s)
  (check-equal? (click s 'preview-lines 8) '(set-preview #hasheq((lines . 8) (mode . "head"))))
  (s 'set-data! 'tool-preview (hasheq 'lines 8 'mode "head"))
  (render s)
  (check-equal? (click s 'preview-mode "match") '(set-preview #hasheq((lines . 8) (mode . "match"))))
  (check-equal? (click s 'preview-edit 'preview-keep) '(none))
  (type! s "(err")
  (check-false (s 'submit!))
  (type! s "error|FAIL")
  (check-equal? (s 'submit!) '(set-preview #hasheq((lines . 8) (mode . "head") (keep . "error|FAIL"))))
  (render s)
  (check-equal? (click s 'preview-edit 'preview-model) '(none))
  (type! s "qwen/qwen3.5-0.8b")
  (check-equal? (s 'submit!) '(set-preview #hasheq((lines . 8) (mode . "head") (model . "qwen/qwen3.5-0.8b"))))
  (render s)
  (check-equal? (click s 'preview-tool-add #f) '(none))
  (type! s "bash sideways 6")
  (check-false (s 'submit!))
  (type! s "bash head_tail 6 keep=error")
  (check-equal? (s 'submit!) (list 'set-preview (hasheq 'lines 8 'mode "head" 'tools (hash "bash" (hasheq 'mode "head_tail" 'lines 6 'keep "error")))))
  (s 'set-data! 'tool-preview (hasheq 'lines 8 'mode "head" 'keep "x" 'tools (hash "bash" (hasheq 'mode "tail"))))
  (render s)
  (check-equal? (click s 'preview-tool-remove "bash") (list 'set-preview (hasheq 'lines 8 'mode "head" 'keep "x" 'tools (hash))))
  (check-equal? (click s 'preview-clear 'keep) (list 'set-preview (hasheq 'lines 8 'mode "head" 'tools (hash "bash" (hasheq 'mode "tail"))))))

