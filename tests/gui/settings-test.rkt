(test-case "project index (§8): status, pause / rescan, model fields (bad endpoint stays), per repo Edit (multi-line, prefilled) / Regenerate"
  (define s (new-sv))
  (s 'open!)
  (s 'set-data! 'hix (hasheq 'paused #f 'endpoint "http://localhost:1234/v1" 'model #f 'found 2 'described 1 'pending 1 'errors 0 'current "notes"
                             'hosts (list (list "This Mac" (list (hasheq 'key "local\u0001/w/shop" 'name "shop" 'dir "/w/shop" 'summary "A shop." 'short "go, 电商" 'state "described" 'error "" 'text "names: shop\nshort: go, 电商")
                                                                 (hasheq 'key "local\u0001/w/notes" 'name "notes" 'dir "/w/notes" 'summary "" 'short "" 'state "pending" 'error "" 'text "names: \nshort: "))))))
  (render s)
  (click s 'section 'projects)
  (define acc '())
  (parameterize ([current-text-sink (lambda (str xs y h soft?) (set! acc (cons str acc)))]) (render s))
  (define text (string-join acc "\n"))
  (check-true (string-contains? text "go, 电商"))
  (check-true (string-contains? text "/w/notes"))
  (check-equal? (click s 'hix-pause #t) '(hix-pause #t))
  (check-equal? (click s 'hix-rescan #f) '(hix-rescan))
  (check-equal? (click s 'hix-regenerate "local\u0001/w/notes") '(hix-regenerate "local\u0001/w/notes"))
  (check-equal? (click s 'hix-edit "local\u0001/w/shop") '(none))
  (check-true (s 'multiline?))
  (check-equal? (editor-flatten (s 'editor)) "names: shop\nshort: go, 电商")
  (editor-insert! (s 'editor) ", mall")
  (check-equal? (s 'submit!) '(hix-edit "local\u0001/w/shop" "names: shop\nshort: go, 电商, mall"))
  (render s)
  (check-equal? (click s 'hix-endpoint-edit #f) '(none))
  (type! s "localhost:1234")
  (check-false (s 'submit!))                                                     ; 不是 http(s)://：留在输入框
  (type! s "http://127.0.0.1:1234/v1")
  (check-equal? (s 'submit!) '(hix-endpoint "http://127.0.0.1:1234/v1"))
  (render s)
  (click s 'hix-model-edit #f)
  (type! s "auto")
  (check-equal? (s 'submit!) '(hix-model #f)))

