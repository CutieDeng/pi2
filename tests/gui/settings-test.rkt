#lang racket/base
;; tests/gui/settings-test.rkt — 设置页组件（单个组件 + 假 text-layout）：分节切换、添加帐号两步输入、key 打码判定、
;; 权限 / 规则 / 删池动作、点外面关闭；英文界面不漏中文

(require rackunit racket/list racket/string
         "../../src/gui/compute/drawlist.rkt" "../../src/gui/compute/interfaces.rkt" "../../src/gui/compute/editor.rkt"
         "../../src/gui/compute/i18n.rkt" "../../src/gui/compute/paint.rkt"
         "../../src/gui/components/settings.rkt" "fakes.rkt")

(define (new-sv) (instantiate-with settings-component settings-view))
(define (render s) (define dl (make-drawlist)) (s 'render! dl 0.0 0.0 960.0 680.0 2.0) dl)
(define PROVIDERS
  (hasheq 'providers (list (hasheq 'name "lmstudio" 'needs_key #f 'has_key #t 'models '("qwen3-8b" "gemma-3"))
                           (hasheq 'name "deepseek" 'needs_key #t 'has_key #t 'models '("deepseek-v4-flash" "deepseek-v4-pro"))
                           (hasheq 'name "deepseek[work]" 'needs_key #t 'has_key #f 'models '("deepseek-v4-flash")))
          'routes (list (hasheq 'name "pool" 'current 0 'members (list (hasheq 'instance "deepseek" 'model "m" 'state "ok"))))))
(define (click s kind payload) (define c (s 'hit-center kind payload)) (s 'hit (car c) (cdr c)))

(test-case "sections; accounts: replace key for an existing account, add a new account (label → key)"
  (define s (new-sv))
  (s 'open!)
  (s 'set-data! 'providers PROVIDERS)
  (render s)
  (check-equal? (click s 'section 'accounts) '(section accounts))
  (render s)
  (check-false (s 'hit-center 'edit-key "lmstudio"))                           ; 本地端点不需要 key
  (check-equal? (click s 'edit-key "deepseek[work]") '(none))
  (check-true (s 'editing?))
  (check-true (s 'secret?))                                                    ; 输 key：日志要打码
  (editor-insert! (s 'editor) "sk-abc")
  (check-equal? (s 'submit!) '(add-key "deepseek" "work" "sk-abc"))
  (check-false (s 'editing?))
  (render s)
  (check-equal? (click s 'new-account "deepseek") '(none))
  (check-false (s 'secret?))                                                   ; 先输帐号名：不是密钥
  (editor-insert! (s 'editor) "bad name")
  (check-false (s 'submit!))                                                   ; 帐号名不合法：留在这一步
  (editor-command! (s 'editor) 'selectAll:)
  (editor-insert! (s 'editor) "team")
  (check-equal? (s 'submit!) '(none))
  (check-true (s 'secret?))
  (editor-insert! (s 'editor) "sk-team")
  (render s)
  (check-equal? (click s 'save #f) '(add-key "deepseek" "team" "sk-team")))

(test-case "permissions / rules / pools actions; outside click closes"
  (define s (new-sv))
  (s 'open!)
  (s 'set-data! 'permission "normal")
  (s 'set-data! 'rules (list (hasheq 'name "qwen3-no-think" 'enabled #t 'source "builtin" 'description "d" 'match (hasheq 'model "qwen3" 'reasoning '("off")))))
  (s 'set-data! 'providers PROVIDERS)
  (render s)
  (click s 'section 'permissions) (render s)
  (check-equal? (click s 'permission "read-only") '(permission "read-only"))
  (click s 'section 'rules) (render s)
  (check-equal? (click s 'rule (vector "qwen3-no-think" #t)) '(rule "qwen3-no-think" #f))
  (click s 'section 'pools) (render s)
  (check-equal? (click s 'ask-delete-route "pool") '(none))                     ; 第一次：确认态
  (render s)
  (check-equal? (click s 'delete-route "pool") '(delete-route "pool"))
  (check-equal? (s 'hit 5.0 5.0) '(close))
  (check-false (s 'open?)))

(test-case "English settings page draws no untranslated Chinese (all sections)"
  (parameterize ([current-lang 'en])
    (define s (new-sv))
    (s 'open!)
    (s 'set-data! 'providers PROVIDERS)
    (s 'set-data! 'rules (list (hasheq 'name "r" 'enabled #f 'source "user" 'description "desc" 'match (hasheq 'model "x"))
                               (hasheq 'name "s" 'enabled #t 'source "settings" 'description "" 'system_append "be brief" 'match (hasheq 'model "y"))))
    (s 'set-data! 'aliases (list (hasheq 'name "fast" 'model "m-fast")))
    (s 'set-data! 'hosts (list (hasheq 'id "local" 'label "This Mac" 'status "connected" 'detail "place" 'removable #f 'active #t)
                               (hasheq 'id "srv" 'label "srv" 'status "disconnected" 'detail "ssh srv · serve default" 'removable #t 'active #f
                                       'subagent #t 'credential "share" 'workdir #f)))
    (s 'set-data! 'host-label "srv")
    (s 'set-data! 'budget (hasheq 'date "2026-10-23" 'spent_today 1.5 'daily_usd 5.0 'turn_usd 'null 'snoozed #t
                                  'by_model (list (hasheq 'model "deepseek-v4-pro" 'usd 1.5))))
    (s 'set-data! 'budget-all (hasheq 'total 2.0 'cap 3.0 'snoozed #t 'hosts (list (hasheq 'label "srv" 'spent 0.5 'cap 'null 'ledger "b"))))
    (s 'set-data! 'permission "auto")
    (define acc '())
    (parameterize ([current-text-sink (lambda (str xs y h soft?) (set! acc (cons str acc)))])
    (s 'set-data! 'instr-global (hasheq 'path "/cfg/AGENTS.md" 'bytes 12))
    (s 'set-data! 'instr-entities (list (hasheq 'id "p1" 'kind "project" 'name "Shop" 'text "prices in cents")
                                        (hasheq 'id "w1" 'kind "workspace" 'name "web @ local" 'text "")))
    (s 'set-data! 'memory (hasheq 'pending (list (hasheq 'id "m3" 'text "x" 'meta "saved by the model" 'pinned #f))
                                  'groups (list (list "Global" (list (hasheq 'id "m1" 'text "y" 'meta "saved by you" 'pinned #t)))) 'global-auto #f))
    (s 'set-data! 'hix (hasheq 'paused #t 'endpoint "http://localhost:1234/v1" 'model "m" 'found 1 'described 0 'pending 0 'errors 1 'current #f
                               'hosts (list (list "This Mac" (list (hasheq 'key "k" 'name "x" 'dir "/x" 'summary "" 'short "" 'state "error" 'error "timeout" 'text ""))))))
      (for ([sec '(general hosts accounts permissions instructions memory projects budget rules pools aliases shortcuts)])
        (render s)
        (click s 'section sec)
        (render s)))
    (define text (string-replace (string-join acc "\n") "中文" ""))          ; 语言选项用各自语言的名字（「中文」），不算漏翻
    (check-false (regexp-match #px"[一-鿿]" text) (format "~s" (regexp-match #px"[一-鿿].{0,10}" text)))
    (check-true (string-contains? text "Accounts & keys"))))

(define (type! s str) (editor-command! (s 'editor) 'selectAll:) (editor-insert! (s 'editor) str))

(test-case "pools: add member (account → model, or Other… → typed id), move up, remove; last member asks to delete the pool; new pool"
  (define s (new-sv))
  (s 'open!)
  (s 'set-data! 'providers PROVIDERS)
  (render s)
  (click s 'section 'pools) (render s)
  (check-equal? (click s 'add-member "pool") '(none))
  (render s)
  (check-false (s 'hit-center 'pick-model (vector "pool" "lmstudio" "qwen3-8b")))   ; 先选帐号
  (check-equal? (click s 'pick-account (vector "pool" "lmstudio")) '(none))
  (render s)
  (check-equal? (click s 'pick-model (vector "pool" "lmstudio" "qwen3-8b"))
                '(define-route "pool" (("deepseek" . "m") ("lmstudio" . "qwen3-8b"))))
  ;; 「其他…」：手输模型 id
  (render s)
  (click s 'add-member "pool") (render s)
  (click s 'pick-account (vector "pool" "deepseek[work]")) (render s)
  (check-equal? (click s 'pick-other (vector "pool" "deepseek[work]")) '(none))
  (check-false (s 'secret?))
  (type! s "custom-model")
  (check-equal? (s 'submit!) '(define-route "pool" (("deepseek" . "m") ("deepseek[work]" . "custom-model"))))
  ;; 两个成员的池：上移、移除
  (s 'set-data! 'providers (hash-set PROVIDERS 'routes (list (hasheq 'name "pool" 'current 0 'members (list (hasheq 'instance "a" 'model "1") (hasheq 'instance "b" 'model "2"))))))
  (render s)
  (check-false (s 'hit-center 'member-up (vector "pool" 0)))                      ; 第一个没有「上移」
  (check-equal? (click s 'member-up (vector "pool" 1)) '(define-route "pool" (("b" . "2") ("a" . "1"))))
  (render s)
  (check-equal? (click s 'member-remove (vector "pool" 0)) '(define-route "pool" (("b" . "2"))))
  (s 'set-data! 'providers PROVIDERS)                                              ; 只剩一个成员
  (render s)
  (check-equal? (click s 'member-remove (vector "pool" 0)) '(none))               ; → 先确认删池
  (render s)
  (check-equal? (click s 'delete-route "pool") '(delete-route "pool"))
  ;; 新建池：名字 → 选帐号 → 选模型
  (render s)
  (check-equal? (click s 'new-pool #f) '(none))
  (type! s "bad name")
  (check-false (s 'submit!))
  (render s)                                                                       ; 提示原因
  (type! s "team")
  (check-equal? (s 'submit!) '(none))
  (render s)
  (click s 'pick-account (vector "team" "deepseek")) (render s)
  (check-equal? (click s 'pick-model (vector "team" "deepseek" "deepseek-v4-pro")) '(define-route "team" (("deepseek" . "deepseek-v4-pro")))))

