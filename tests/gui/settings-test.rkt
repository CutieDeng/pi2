(test-case "multi-line only for rule text; custom secret formats: add (bad regex stays), remove"
  (define s (new-sv))
  (s 'open!)
  (s 'set-data! 'rules '())
  (render s)
  (click s 'section 'rules) (render s)
  (click s 'new-rule #f)
  (check-false (s 'multiline?))                                          ; 规则名：单行
  (type! s "r1") (s 'submit!)
  (type! s "*") (s 'submit!)
  (check-true (s 'multiline?))                                           ; 追加的文字：多行
  (s 'cancel-edit!)
  (s 'set-data! 'secret-patterns '("^myco_[a-z0-9]{8}$"))
  (click s 'section 'general) (render s)
