(test-case "instructions (M1): entities by kind; Add / Edit opens a multi-line field prefilled with the text; Enter saves; saving empty clears; Open file"
  (define s (new-sv))
  (s 'open!)
  (s 'set-data! 'instr-global (hasheq 'path "/cfg/AGENTS.md" 'bytes #f))
  (s 'set-data! 'instr-entities (list (hasheq 'id "p1" 'kind "project" 'name "Shop" 'text "prices in cents\nno floats")
                                      (hasheq 'id "s1" 'kind "super-workspace" 'name "shop repo" 'text "")
                                      (hasheq 'id "w1" 'kind "workspace" 'name "web @ local" 'text "")))
  (render s)
  (click s 'section 'instructions)
  (define acc '())
  (parameterize ([current-text-sink (lambda (str xs y h soft?) (set! acc (cons str acc)))]) (render s))
  (define text (string-join acc "\n"))
  (check-true (string-contains? text "/cfg/AGENTS.md"))
  (check-true (string-contains? text "prices in cents"))                         ; 第一行预览
  (check-false (string-contains? text "no floats"))
  (check-true (string-contains? text "web @ local"))
  (check-equal? (click s 'instr-open-global #f) '(open-global-instructions))
  ;; 改已有的：预填原文、多行
  (check-equal? (click s 'instr-edit "p1") '(none))
  (check-true (s 'editing?))
  (check-true (s 'multiline?))
  (check-false (s 'secret?))
  (check-equal? (editor-flatten (s 'editor)) "prices in cents\nno floats")
  (editor-insert! (s 'editor) "\nround half up")
  (render s)
  (check-true (vector? (s 'caret-rect)))
  (check-equal? (s 'submit!) '(set-instructions "p1" "prices in cents\nno floats\nround half up"))
  (check-false (s 'editing?))
  ;; 新加：空的输入框；存空 = 清掉
  (render s)
  (check-equal? (click s 'instr-edit "w1") '(none))
