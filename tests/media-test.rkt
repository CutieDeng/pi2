#lang tstring racket
;; media-test.rkt — 消息里的媒体（P4，design-content.md §3.3）：blob 存储；按模型能力投影（OpenAI chat / Anthropic / Responses）；
;; prompt 带媒体 → 记录里只有引用、条目里有媒体段、blob 请求分块取回；定期垃圾回收只删没被引用的、过了宽限期的。

(require rackunit json net/base64 racket/async-channel racket/file
         (file "../src/model.rkt") (file "../src/media.rkt") (file "../src/provider.rkt") (file "../src/provider-anthropic.rkt")
         (file "../src/provider-responses.rkt") (file "../src/session.rkt") (file "../src/event.rkt") (file "../src/tool.rkt")
         (file "../src/permission.rkt") (file "../src/loop.rkt") (file "../src/plugin.rkt") (file "../src/rpc.rkt"))

(define dir (make-temporary-file "pi2-media-~a" 'directory))
(void (putenv "PI_CONFIG_HOME" (path->string dir)))
(define root (blob-root-of dir))
(define PNG (bytes-append #"\x89PNG\r\n\x1a\n" (make-bytes 300 7)))

(test-case "blob store: content-addressed, one copy per content, ranged reads"
  (define a (blob-put! root PNG))
  (check-equal? a (sha256-hex PNG))
  (check-equal? (blob-put! root PNG) a)
  (check-equal? (length (directory-list (build-path root (substring a 0 2)))) 1)
  (check-equal? (blob-bytes root a) PNG)
  (define-values (bs total) (blob-read-range root a 8 10))
  (check-equal? (list bs total) (list (make-bytes 10 7) (bytes-length PNG)))
  (check-false (blob-bytes root (make-string 64 #\0))))

(test-case "caps: vision models take images, others get a text placeholder; media-caps.rktd overrides"
  (check-true (hash-ref (media-caps "claude-sonnet-5-5") 'image))
  (check-true (hash-ref (media-caps "gemma-4-31b-it@6bit") 'image))
  (check-false (hash-ref (media-caps "deepseek-v4-flash") 'image))
  (check-false (hash-ref (media-caps "claude-sonnet-5-5") 'audio))
  (with-output-to-file (build-path dir "media-caps.rktd") #:exists 'truncate
    (lambda () (write '(("^deepseek-v9" . #hasheq((image . #t) (audio . #t)))))))
  (check-true (hash-ref (media-caps "deepseek-v9-pro") 'audio))
  (delete-file (build-path dir "media-caps.rktd"))
  (check-equal? (media-placeholder (media-block 'audio "audio/mp4" "x" "memo.m4a" (hasheq 'duration 12.34 'transcript "hello")))
                "[audio: memo.m4a, 12.3 s] transcript: hello"))

(define sha (sha256-hex PNG))
(define msg (message 'user (list (text-block "what is this?")
                                 (media-block 'image "image/png" sha "shot.png" (hasheq 'width 640 'height 480))
                                 (media-block 'audio "audio/mp4" sha "memo.m4a" (hasheq 'duration 3.0)))))
(define (with-model m thunk) (parameterize ([current-config (struct-copy config (default-config) [model m])] [current-blob-root root]) (thunk)))
(define B64 (bytes->string/latin-1 (base64-encode PNG #"")))

(test-case "projection: OpenAI chat / Anthropic / Responses put the image inline for vision models; audio and non-vision → placeholders"
  (define oa (car (with-model "gpt-5" (lambda () (message->openai-msgs msg)))))
  (check-equal? (map (lambda (p) (hash-ref p 'type)) (hash-ref oa 'content)) '("text" "image_url"))
  (check-equal? (hash-ref (hash-ref (cadr (hash-ref oa 'content)) 'image_url) 'url) (string-append "data:image/png;base64," B64))
  (check-regexp-match #rx"what is this\\?\n\\[audio: memo.m4a, 3.0 s\\]" (hash-ref (car (hash-ref oa 'content)) 'text))
  (define plain (car (with-model "deepseek-v4-flash" (lambda () (message->openai-msgs msg)))))
  (check-equal? (hash-ref plain 'content) "what is this?\n[image: shot.png, 640×480]\n[audio: memo.m4a, 3.0 s]")
  (define an (with-model "claude-sonnet-5-5" (lambda () (message->anthropic msg))))
  (check-equal? (map (lambda (p) (hash-ref p 'type)) (hash-ref an 'content)) '("image" "text"))
  (check-equal? (hash-ref (hash-ref (car (hash-ref an 'content)) 'source) 'data) B64)
  (define rs (car (with-model "gpt-5" (lambda () (message->input-items msg)))))
  (check-equal? (map (lambda (p) (hash-ref p 'type)) (hash-ref rs 'content)) '("input_text" "input_image"))
  ;; blob 丢了：退回占位，不报错
  (define gone (message 'user (list (text-block "x") (media-block 'image "image/png" (make-string 64 #\a) "lost.png" (hasheq)))))
  (check-equal? (hash-ref (car (with-model "gpt-5" (lambda () (message->openai-msgs gone)))) 'content) "x\n[image: lost.png]"))

(test-case "rpc: prompt with media → the record holds only a reference; the item has a media part; blob gives the bytes back in chunks"
  (define seen (box #f))
  (define prov (provider "s" (lambda (msgs _t)
                               (set-box! seen (last msgs))
                               (define ch (make-async-channel))
                               (async-channel-put ch (evt:message (now-ms) (text-msg 'assistant "a picture")))
                               (async-channel-put ch (evt:turn-end (now-ms) "stop" (usage 1 1)))
                               ch)
                         void))
  (define cfg (struct-copy config (default-config) [workdir (path->string dir)]))
  (define path (fresh-session-path (path->string dir)))
  (define sess (session-open! path cfg))
  (define host (make-plugin-host))
  (define d (make-deps #:provider prov #:registry (make-registry '()) #:bus (make-bus) #:policy (make-policy cfg) #:plugin-host host))
  (define-values (in-r in-w) (make-pipe)) (define-values (out-r out-w) (make-pipe))
  (thread (lambda () (parameterize ([current-input-port in-r] [current-output-port out-w])
                       (run-rpc! d (make-initial-state cfg) sess #:plugin-host host #:fetch-models (lambda (_e) #f)))
            (close-output-port out-w)))
  (define (send! j) (write-string (jsexpr->string j) in-w) (newline in-w) (flush-output in-w))
  (define (read-type type) (let loop () (define j (string->jsexpr (sync/timeout 10 (read-line-evt out-r 'linefeed)))) (if (equal? (hash-ref j 'type #f) type) j (loop))))
  (define big (make-bytes 700000 65))
  (send! (hasheq 'type "prompt" 'text "look"
                 'media (list (hasheq 'kind "image" 'media_type "image/png" 'name "shot.png" 'data B64 'meta (hasheq 'width 640 'height 480 'junk (hasheq)))
                              (hasheq 'media_type "audio/wav" 'name "a.wav" 'data (bytes->string/latin-1 (base64-encode big #""))))))
  (define it (let loop () (define j (read-type "item")) (if (equal? (hash-ref j 'kind) "user") j (loop))))
  (define parts (hash-ref it 'parts))
  (check-equal? (map (lambda (p) (list (hash-ref p 'type) (hash-ref p 'kind #f))) parts) '(("text" #f) ("media" "image") ("media" "audio")))
  (check-equal? (hash-ref (cadr parts) 'sha) sha)
  (check-equal? (hash-ref (hash-ref (cadr parts) 'meta) 'width) 640)
  (check-false (hash-has-key? (hash-ref (cadr parts) 'meta) 'junk))
  (check-equal? (hash-ref (hash-ref (caddr parts) 'meta) 'bytes) 700000)
  (read-type "turn_complete")
  (check-equal? (map (lambda (b) (if (media-block? b) (media-block-kind b) 'text)) (message-blocks (unbox seen))) '(text image audio))
  ;; 记录文件里没有媒体内容（只有 sha）
  (check-true (< (file-size path) 20000))
  ;; 分块取回：512 KB 一块
  (define asha (hash-ref (caddr parts) 'sha))
  (send! (hasheq 'type "blob" 'sha asha 'tag "b1"))
  (define c1 (read-type "blob_data"))
  (check-equal? (list (hash-ref c1 'total) (hash-ref c1 'offset) (hash-ref c1 'tag)) '(700000 0 "b1"))
  (define d1 (base64-decode (string->bytes/latin-1 (hash-ref c1 'data))))
  (send! (hasheq 'type "blob" 'sha asha 'offset (bytes-length d1)))
  (define d2 (base64-decode (string->bytes/latin-1 (hash-ref (read-type "blob_data") 'data))))
  (check-equal? (bytes-append d1 d2) big)
  (send! (hasheq 'type "blob" 'sha (make-string 64 #\b)))
  (check-equal? (hash-ref (read-type "blob_data") 'error) "no such blob")
  (send! (hasheq 'type "shutdown")) (void (read-type "bye")))

(test-case "gc: unreferenced blobs past the grace period are deleted; referenced ones (messages, compaction history) stay; once a day"
  (define gdir (make-temporary-file "pi2-gc-~a" 'directory))
  (define groot (blob-root-of gdir))
  (define keep1 (blob-put! groot #"in a message"))
  (define keep2 (blob-put! groot #"in a compaction"))
  (define drop (blob-put! groot #"nobody"))
  (define fresh (blob-put! groot #"just uploaded"))
  (define old (- (current-seconds) 7200))
  (for ([s (list keep1 keep2 drop)]) (file-or-directory-modify-seconds (blob-file groot s) old))
  (define cfg (struct-copy config (default-config) [workdir (path->string gdir)]))
  (define s1 (session-open! (fresh-session-path (path->string gdir)) cfg))
  (session-append-msg! s1 (message 'user (list (text-block "a") (media-block 'image "image/png" keep1 #f (hasheq)))))
  (session-close! s1)
  (define s2 (session-open! (fresh-session-path (path->string gdir)) cfg))
  (session-append-msg! s2 (text-msg 'user "b"))
  (session-append-compact! s2 (hasheq 'history (list (message 'user (list (media-block 'file "text/plain" keep2 "x.txt" (hasheq))))) 'usage (usage 0 0)))
  (session-close! s2)
  (check-equal? (blobs-gc! gdir session-media-records) 1)
  (check-equal? (map (lambda (s) (file-exists? (blob-file groot s))) (list keep1 keep2 drop fresh)) '(#t #t #f #t))
  (check-equal? (blobs-gc! gdir session-media-records) 0)                       ; 不到一天：不扫
  (delete-directory/files gdir))

(delete-directory/files dir)
