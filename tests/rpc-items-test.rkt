#lang tstring racket
;; rpc-items-test.rkt — RPC v3（design-content.md §4.2）：会话记录投影成界面条目。经 run-rpc! 跑真实的轮：
;; 实时 item 事件 = 之后用 items 翻页取回的（同一投影，逐字段比对）；item 取单条全文（长工具输出）；
;; index_summary 每条记录 6 字节；应答带回请求的 tag；session 事件只带尾部、带轮数。

(require rackunit json net/base64 racket/async-channel
         (file "../src/model.rkt") (file "../src/event.rkt") (file "../src/provider.rkt") (file "../src/tool.rkt")
         (file "../src/permission.rkt") (file "../src/loop.rkt") (file "../src/session.rkt") (file "../src/plugin.rkt")
         (file "../src/rpc.rkt") (file "../src/tools/builtin.rkt"))

(define dir (make-temporary-file "pi2-items-~a" 'directory))
(void (putenv "PI_CONFIG_HOME" (path->string dir)))

;; 脚本模型：含 run → 调 bash（输出 300 行）；拿到结果后回答（带推理）；其余 → 回答
(define (make-prov)
  (provider "s"
            (lambda (msgs _t)
              (define ch (make-async-channel))
              (define lm (last msgs))
              (define tr (for/first ([b (message-blocks lm)] #:when (tool-result-block? b)) b))
              (thread (lambda ()
                        (cond
                          [tr (async-channel-put ch (evt:message (now-ms) (message 'assistant (list (thinking-block "looked at it" "sig") (text-block "done: 300 lines")))))
                              (async-channel-put ch (evt:turn-end (now-ms) "stop" (usage 30 4)))]
                          [(regexp-match? #rx"run" (message-text lm))
                           (async-channel-put ch (evt:message (now-ms) (message 'assistant (list (text-block "running") (tool-use-block "c1" "bash" (hasheq 'command "seq 1 300"))))))
                           (async-channel-put ch (evt:turn-end (now-ms) "tool_calls" (usage 20 3)))]
                          [else (async-channel-put ch (evt:message (now-ms) (text-msg 'assistant "ok")))
                                (async-channel-put ch (evt:turn-end (now-ms) "stop" (usage 1 1)))])))
              ch)
            void))

(define (start!)
  (define cfg (struct-copy config (default-config) [workdir (path->string dir)] [permission-mode 'yolo] [model "deepseek-v4-flash"]))
  (define path (fresh-session-path (path->string dir)))
  (define sess (session-open! path cfg))
  (define host (make-plugin-host))
  (define d (make-deps #:provider (make-prov) #:registry (make-registry (builtin-tools cfg)) #:bus (make-bus) #:policy (make-policy cfg) #:plugin-host host))
  (define-values (in-r in-w) (make-pipe)) (define-values (out-r out-w) (make-pipe))
  (thread (lambda () (parameterize ([current-input-port in-r] [current-output-port out-w])
                       (run-rpc! d (make-initial-state cfg) sess #:plugin-host host #:fetch-models (lambda (_e) #f)))
            (close-output-port out-w)))
  (define seen '())
  (define (send! j) (write-string (jsexpr->string j) in-w) (newline in-w) (flush-output in-w))
  (define (expect! type)
    (let loop ()
      (define l (sync/timeout 10 (read-line-evt out-r 'linefeed)))
      (unless (string? l) (error 'expect! "timeout waiting for ~a" type))
      (define j (string->jsexpr l))
      (set! seen (cons j seen))
      (if (equal? (hash-ref j 'type #f) type) j (loop))))
  (values send! expect! (lambda () (reverse seen))))

(define (strip it) (hash-remove (hash-remove (hash-remove it 'type) 'tag) 'ts))

(test-case "live item events = the same records paged in with items; item gives the full tool output; index_summary; tags echoed"
  (define-values (send! expect! seen) (start!))
  (define rd (expect! "ready"))
  (check-equal? (hash-ref rd 'protocol) 3)
  (define s0 (expect! "session"))
  (check-equal? (hash-ref s0 'turns) 0)
  (send! (hasheq 'type "prompt" 'text "please run it"))
  (expect! "turn_complete")
  (define live (filter (lambda (j) (equal? (hash-ref j 'type #f) "item")) (seen)))
  (check-equal? (map (lambda (j) (hash-ref j 'kind)) live)
                '("user" "usage" "assistant" "tool" "results" "usage" "assistant"))     ; 用量在请求结束时记（消息追加之前）
  ;; 翻页取回同一段：逐字段相同（预览长度一样时）
  (send! (hasheq 'type "items" 'from 0 'to 1000 'tag "t1"))
  (define pg (expect! "items"))
  (check-equal? (hash-ref pg 'tag) "t1")
  (check-equal? (map strip (hash-ref pg 'items)) (map strip live))
  ;; 工具结果预览：只带前 preview_bytes 个字符 + 全长；item 按 id 取全文
  (send! (hasheq 'type "items" 'from 0 'to 1000 'preview_bytes 20 'tag "t2"))
  (define small (expect! "items"))
  (define rs (findf (lambda (i) (equal? (hash-ref i 'kind) "results")) (hash-ref small 'items)))
  (define part (car (hash-ref rs 'parts)))
  (check-equal? (string-length (hash-ref part 'content)) 20)
  (check-true (hash-ref part 'truncated))
  (check-true (> (hash-ref part 'total_len) 1000))
  (send! (hasheq 'type "item" 'id (hash-ref rs 'id) 'tag "t3"))
  (define full (expect! "item_full"))
  (check-equal? (hash-ref full 'tag) "t3")
  (check-equal? (string-length (hash-ref (car (hash-ref full 'parts)) 'content)) (hash-ref part 'total_len))
  (check-regexp-match #rx"\n300" (hash-ref (car (hash-ref full 'parts)) 'content))
  ;; 摘要：每条记录 6 字节；显示种类与条目一致（1 user 2 assistant 3 results 6 usage 9 只更新别的条目）
  (send! (hasheq 'type "index_summary" 'from 0 'to 1000 'tag "t4"))
  (define sm (expect! "index_summary"))
  (check-equal? (hash-ref sm 'tag) "t4")
  (define bs (base64-decode (string->bytes/latin-1 (hash-ref sm 'data))))
  (check-equal? (bytes-length bs) (* 6 (hash-ref sm 'total)))
  (define kinds (for/list ([i (in-list live)]) (bytes-ref bs (* 6 (hash-ref i 'id)))))
  (check-equal? kinds '(1 6 2 9 3 6 2))
  (check-equal? (bitwise-and (bytes-ref bs (+ 1 (* 6 (hash-ref (list-ref live 6) 'id)))) 1) 1)   ; 第二个回答带推理
  ;; session_info：尾部条目 + 轮数
  (send! (hasheq 'type "session_info"))
  (define s1 (expect! "session"))
  (check-equal? (hash-ref s1 'turns) 1)
  (check-equal? (hash-ref s1 'tail_from) 0)
  (check-equal? (map strip (hash-ref s1 'items)) (map strip live))
  (send! (hasheq 'type "shutdown")) (void (expect! "bye")))

(test-case "the session tail is bounded: a long session sends only the last records; earlier ones page in"
  (define cfg (struct-copy config (default-config) [workdir (path->string dir)]))
  (define path (fresh-session-path (path->string dir)))
  (define s (session-open! path cfg))
  (for ([i 400]) (session-append-msg! s (text-msg (if (even? i) 'user 'assistant) (format "m~a" i))))
  (session-close! s)
  (define sess (session-open! path cfg))
  (define host (make-plugin-host))
  (define d (make-deps #:provider (make-prov) #:registry (make-registry '()) #:bus (make-bus) #:policy (make-policy cfg) #:plugin-host host))
  (define-values (in-r in-w) (make-pipe)) (define-values (out-r out-w) (make-pipe))
  (thread (lambda () (parameterize ([current-input-port in-r] [current-output-port out-w])
                       (run-rpc! d (session-replay path) sess #:plugin-host host #:fetch-models (lambda (_e) #f)))
            (close-output-port out-w)))
  (define (read-type type) (let loop () (define j (string->jsexpr (sync/timeout 10 (read-line-evt out-r 'linefeed)))) (if (equal? (hash-ref j 'type #f) type) j (loop))))
  (define ss (read-type "session"))
  (check-equal? (hash-ref ss 'total) 401)                         ; meta + 400
  (check-true (< (length (hash-ref ss 'items)) 200))
  (check-equal? (hash-ref ss 'turns) 200)
  (define first-tail (hash-ref (car (hash-ref ss 'items)) 'id))
  (check-equal? first-tail (hash-ref ss 'tail_from))
  (write-string (jsexpr->string (hasheq 'type "items" 'from 1 'to 3)) in-w) (newline in-w) (flush-output in-w)
  (define pg (read-type "items"))
  (check-equal? (map (lambda (i) (hash-ref (car (hash-ref i 'parts)) 'text)) (hash-ref pg 'items)) '("m0" "m1"))
  (write-string (jsexpr->string (hasheq 'type "shutdown")) in-w) (newline in-w) (flush-output in-w)
  (void (read-type "bye")))

(test-case "select_lines: the local model's reply becomes line numbers; non-local endpoints are refused; errors come back as lines.error"
  (define seen-prompt (box #f))
  (define (fake-complete ep model msgs)
    (set-box! seen-prompt (list ep model (message-text (cadr msgs))))
    (if (equal? model "broken") "sorry, no idea" "[3, 300, 9999, 3]"))
  (define cfg (struct-copy config (default-config) [workdir (path->string dir)] [permission-mode 'yolo]))
  (define path (fresh-session-path (path->string dir)))
  (define sess (session-open! path cfg))
  (define host (make-plugin-host))
  (define d (make-deps #:provider (make-prov) #:registry (make-registry (builtin-tools cfg)) #:bus (make-bus) #:policy (make-policy cfg) #:plugin-host host))
  (define-values (in-r in-w) (make-pipe)) (define-values (out-r out-w) (make-pipe))
  (thread (lambda () (parameterize ([current-input-port in-r] [current-output-port out-w])
                       (run-rpc! d (make-initial-state cfg) sess #:plugin-host host #:fetch-models (lambda (_e) (cons '("m1") '("m1"))) #:complete-local fake-complete))
            (close-output-port out-w)))
  (define (send! j) (write-string (jsexpr->string j) in-w) (newline in-w) (flush-output in-w))
  (define (read-type type) (let loop () (define j (string->jsexpr (sync/timeout 10 (read-line-evt out-r 'linefeed)))) (if (equal? (hash-ref j 'type #f) type) j (loop))))
  (send! (hasheq 'type "prompt" 'text "please run it"))
  (read-type "turn_complete")
  (send! (hasheq 'type "items" 'from 0 'to 100))
  (define rs (findf (lambda (i) (equal? (hash-ref i 'kind) "results")) (hash-ref (read-type "items") 'items)))
  (define rid (hash-ref rs 'id))
  ;; 没指定模型：用端点上已加载的第一个
  (send! (hasheq 'type "select_lines" 'id rid 'call_id "c1" 'tool "bash" 'summary "seq 1 300" 'max_lines 5 'tag "s1"))
  (define l1 (read-type "lines"))
  (check-equal? (list (hash-ref l1 'lines) (hash-ref l1 'model) (hash-ref l1 'tag)) '((3 300) "m1" "s1"))
  (check-equal? (car (unbox seen-prompt)) "http://localhost:1234/v1")
  (check-regexp-match #rx"Output has 301 lines" (caddr (unbox seen-prompt)))
  (send! (hasheq 'type "select_lines" 'id rid 'call_id "c1" 'max_lines 5 'model "broken"))
  (check-regexp-match #rx"could not read line numbers" (hash-ref (read-type "lines") 'error))
  (send! (hasheq 'type "select_lines" 'id rid 'call_id "c1" 'max_lines 5 'model "m1" 'endpoint "https://api.example.com/v1"))
  (check-regexp-match #rx"not on this machine" (hash-ref (read-type "lines") 'error))
  (send! (hasheq 'type "select_lines" 'id rid 'call_id "nope" 'max_lines 5))
  (check-regexp-match #rx"no such tool result" (hash-ref (read-type "lines") 'error))
  (send! (hasheq 'type "shutdown")) (void (read-type "bye")))

(test-case "stream checkpoints (configurable; off by default): while streaming, partial records marked checkpoint are written but not shown as items"
  (define cfg (struct-copy config (default-config) [workdir (path->string dir)]))
  (define path (fresh-session-path (path->string dir)))
  (define sess (session-open! path cfg))
  (define go (make-semaphore 0))
  (define prov (provider "s" (lambda (msgs _t)
                               (define ch (make-async-channel))
                               (thread (lambda ()
                                         (for ([i 6]) (async-channel-put ch (evt:delta (now-ms) 'text (format "chunk~a " i))) (sleep 0.12))
                                         (async-channel-put ch (evt:message (now-ms) (text-msg 'assistant "chunk0 … chunk5")))
                                         (async-channel-put ch (evt:turn-end (now-ms) "stop" (usage 1 1)))))
                               ch)
                         void))
  (define host (make-plugin-host))
  (define d (make-deps #:provider prov #:registry (make-registry '()) #:bus (make-bus) #:policy (make-policy cfg) #:plugin-host host))
  (define-values (in-r in-w) (make-pipe)) (define-values (out-r out-w) (make-pipe))
  (thread (lambda () (parameterize ([current-input-port in-r] [current-output-port out-w])
                       (run-rpc! d (make-initial-state cfg) sess #:plugin-host host #:fetch-models (lambda (_e) #f)))
            (close-output-port out-w)))
  (define (send! j) (write-string (jsexpr->string j) in-w) (newline in-w) (flush-output in-w))
  (define seen '())
  (define (read-type type) (let loop () (define j (string->jsexpr (sync/timeout 10 (read-line-evt out-r 'linefeed)))) (set! seen (cons j seen)) (if (equal? (hash-ref j 'type #f) type) j (loop))))
  (send! (hasheq 'type "set_stream_checkpoint" 'seconds 0.2))
  (check-equal? (hash-ref (read-type "ok") 'seconds) 0.2)
  (send! (hasheq 'type "prompt" 'text "stream please"))
  (read-type "turn_complete")
  (define cps (map rec-data (records-of-type path 'partial)))
  (check-true (>= (length cps) 2) (format "~a checkpoints" (length cps)))
  (check-true (andmap (lambda (h) (eq? (hash-ref h 'checkpoint #f) #t)) cps))
  (check-regexp-match #rx"^chunk0 chunk1" (hash-ref (last cps) 'text))
  (check-false (findf (lambda (j) (and (equal? (hash-ref j 'type #f) "item") (equal? (hash-ref j 'kind #f) "partial"))) seen))
  (send! (hasheq 'type "shutdown")) (void (read-type "bye")))
