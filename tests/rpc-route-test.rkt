#lang tstring racket
;; rpc-route-test.rkt — RPC 下的路由池：define_route / set_provider "@池" / 出错切换的 route_switch 与 route_status 事件 /
;; state 与 list_providers 里的池 / 会话记住池（new_session → resume 恢复）/ 选普通供应商离开池。
;; 真实分发 provider（make-dispatch-provider）+ 假的具体 provider，不碰网络。

(require
 rackunit json racket/async-channel racket/file racket/port
 (file "../src/model.rkt") (file "../src/event.rkt") (file "../src/provider.rkt") (file "../src/tool.rkt")
 (file "../src/permission.rkt") (file "../src/loop.rkt") (file "../src/session.rkt") (file "../src/plugin.rkt")
 (file "../src/providers.rkt") (file "../src/rpc.rkt") (file "../src/route.rkt") (file "../src/secrets.rkt")
) ; end require

(define cfg-dir (make-temporary-file "pi2-rpcroute-~a" 'directory))
(void (putenv "PI_CONFIG_HOME" (path->string cfg-dir)))
(reload-health!)

(define behaviors (make-hash))                       ; 实例 → 'ok | (cons 'err 文案)
(define (fake-factory inst)
  (lambda (_cfg)
    (provider inst
              (lambda (msgs _tools)
                (define ch (make-async-channel))
                (define model (config-model (current-config)))
                (define b (hash-ref behaviors inst 'ok))
                (thread (lambda ()
                          (match b
                            ['ok (async-channel-put ch (evt:delta (now-ms) 'text (format "~a/~a" inst model)))
                                 (async-channel-put ch (evt:message (now-ms) (text-msg 'assistant (format "answer from ~a/~a" inst model))))
                                 (async-channel-put ch (evt:turn-end (now-ms) "stop" (usage 1 1)))]
                            [(cons 'err text) (async-channel-put ch (evt:error (now-ms) (exn:fail text (current-continuation-marks)) #f))])))
                ch)
              void)))

(define (start)
  (define dir (make-temporary-file "pi2-rpcroute-ws-~a" 'directory))
  (define cfg (struct-copy config (default-config) [workdir (path->string dir)] [permission-mode 'yolo]))
  (define host (make-plugin-host))
  (register-builtin-providers! host)
  (hash-set! (plugin-host-providers host) "fa" (fake-factory "fa"))
  (hash-set! (plugin-host-providers host) "fb" (fake-factory "fb"))
  (define d (make-deps #:provider (make-dispatch-provider host cfg) #:registry (make-registry '())
                       #:bus (make-bus) #:policy (make-policy cfg) #:plugin-host host))
  (define sess-path (fresh-session-path (path->string dir)))
  (define sess (session-open! sess-path cfg))
  (define-values (in-r in-w) (make-pipe))
  (define-values (out-r out-w) (make-pipe))
  (thread (lambda ()
            (parameterize ([current-input-port in-r] [current-output-port out-w])
              (run-rpc! d (make-initial-state cfg) sess #:plugin-host host #:fetch-models (lambda (_e) #f)))
            (close-output-port out-w)))
  (define (send! j) (write-string (jsexpr->string j) in-w) (newline in-w) (flush-output in-w))
  (define (expect! type)
    (let loop ([seen '()])
      (define l (sync/timeout 5 (read-line-evt out-r 'linefeed)))
      (define j (and (string? l) (string->jsexpr l)))
      (cond [(not (hash? j)) (fail (format "timeout waiting for ~a; saw ~a" type (map (lambda (x) (hash-ref x 'type #f)) (reverse seen)))) (values #f (reverse seen))]
            [(equal? (hash-ref j 'type #f) type) (values j (reverse seen))]
            [else (loop (cons j seen))])))
  (values send! expect! sess-path))

(test-case "pool over RPC: switch on 429 is visible (route_switch + route_status); state / providers show the pool"
  (define-values (send! expect! sess-path) (start))
  (expect! "ready")
  (send! (hasheq 'type "define_route" 'name "pool" 'members (list (hasheq 'instance "fa" 'model "m1") (hasheq 'instance "fb" 'model "m2"))))
  (expect! "ok")
  (send! (hasheq 'type "set_provider" 'name "@pool"))
  (define-values (ok _s) (expect! "ok"))
  (check-equal? (hash-ref ok 'model) "m1")
  (define-values (rs0 _s0) (expect! "route_status"))
  (check-equal? (hash-ref rs0 'current) 0)
  (hash-set! behaviors "fa" (cons 'err "HTTP 429: rate limit reached for account fa"))
  (send! (hasheq 'type "prompt" 'text "hello"))
  (define-values (sw seen) (expect! "route_switch"))
  (check-equal? (hash-ref (hash-ref sw 'from) 'instance) "fa")
  (check-equal? (hash-ref (hash-ref sw 'to) 'instance) "fb")
  (check-regexp-match #rx"429" (hash-ref sw 'reason))
  (define-values (tc seen2) (expect! "turn_complete"))
  (check-false (hash-ref tc 'interrupted))
  (check-not-false (memf (lambda (j) (and (equal? (hash-ref j 'type #f) "message") (regexp-match? #rx"fb/m2" (hash-ref j 'text "")))) seen2))
  (check-false (memf (lambda (j) (equal? (hash-ref j 'type #f) "error")) (append seen seen2)))   ; 切换成功：没有错误事件
  (send! (hasheq 'type "state"))
  (define-values (st _s3) (expect! "state"))
  (check-equal? (hash-ref st 'provider) "@pool")
  (check-equal? (hash-ref st 'model) "m2")
  (check-equal? (hash-ref (hash-ref st 'route) 'current) 1)
  (check-equal? (hash-ref (hash-ref st 'route) 'unavailable) 1)
  (check-equal? (hash-ref (car (hash-ref (hash-ref st 'route) 'members)) 'state) "cooling")
  (send! (hasheq 'type "list_providers"))
  (define-values (pv _s4) (expect! "providers"))
  (check-equal? (hash-ref pv 'current) "@pool")
  (check-equal? (map (lambda (r) (hash-ref r 'name)) (hash-ref pv 'routes)) '("pool"))
  ;; 会话记住池：新会话（继承当前选择）→ 选普通供应商离开池 → 切回原会话 → 池恢复
  (send! (hasheq 'type "new_session"))
  (expect! "session")
  (send! (hasheq 'type "set_provider" 'name "lmstudio"))
  (expect! "ok")
  (send! (hasheq 'type "state"))
  (define-values (st2 _s5) (expect! "state"))
  (check-equal? (hash-ref st2 'provider) "lmstudio")
  (check-equal? (hash-ref st2 'route) 'null)
  (send! (hasheq 'type "resume" 'path (path->string sess-path)))
  (expect! "session")
  (send! (hasheq 'type "state"))
  (define-values (st3 _s6) (expect! "state"))
  (check-equal? (hash-ref st3 'provider) "@pool")
  (send! (hasheq 'type "route_reset" 'instance "fa" 'model "m1"))
  (define-values (rs1 _s7) (expect! "route_status"))
  (check-equal? (hash-ref rs1 'unavailable) 0)
  (send! (hasheq 'type "shutdown"))
  (expect! "bye"))

(test-case "unknown route and malformed define_route are errors"
  (define-values (send! expect! _p) (start))
  (expect! "ready")
  (send! (hasheq 'type "set_provider" 'name "@nope"))
  (define-values (e1 _s) (expect! "error"))
  (check-regexp-match #rx"unknown route" (hash-ref e1 'message))
  (send! (hasheq 'type "define_route" 'name "bad" 'members (list (hasheq 'instance "fa"))))
  (define-values (e2 _s2) (expect! "error"))
  (check-regexp-match #rx"define_route" (hash-ref e2 'message))
  (send! (hasheq 'type "shutdown"))
  (expect! "bye"))

(test-case "settings over RPC: permission mode switch (state reports it), list of all adaptation rules"
  (define-values (send! expect! _p) (start))
  (expect! "ready")
  (send! (hasheq 'type "set_permission_mode" 'mode "read-only"))
  (define-values (ok _s) (expect! "ok"))
  (check-equal? (hash-ref ok 'mode) "read-only")
  (send! (hasheq 'type "state"))
  (define-values (st _s2) (expect! "state"))
  (check-equal? (hash-ref st 'permission_mode) "read-only")
  (send! (hasheq 'type "set_permission_mode" 'mode "sudo"))
  (define-values (e _s3) (expect! "error"))
  (check-regexp-match #rx"unknown mode" (hash-ref e 'message))
  (send! (hasheq 'type "list_adaptations"))
  (define-values (ad _s4) (expect! "adaptations"))
  (define names (map (lambda (r) (hash-ref r 'name)) (hash-ref ad 'rules)))
  (check-not-false (member "qwen3-no-think" names))
  (check-not-false (member "deepseek-r1-usage" names))
  (check-equal? (hash-ref (hash-ref (car (hash-ref ad 'rules)) 'match) 'reasoning) '("off"))
  (send! (hasheq 'type "shutdown"))
  (expect! "bye"))

(test-case "register_secret: stores the value locally and answers with its handle; a placeholder (replay) registers nothing"
  (define-values (send! expect! _p) (start))
  (expect! "ready")
  (send! (hasheq 'type "register_secret" 'value "sk-chat-0123456789abcdef" 'label "chat"))
  (define-values (ok _s) (expect! "ok"))
  (check-equal? (hash-ref ok 'handle) (secret-handle "sk-chat-0123456789abcdef"))
  (check-equal? (secret-value (hash-ref ok 'handle)) "sk-chat-0123456789abcdef")   ; 工具按句柄取得到
  (send! (hasheq 'type "register_secret" 'value "⟦secret:deadbeef⟧"))
  (define-values (ok2 _s2) (expect! "ok"))
  (check-equal? (hash-ref ok2 'handle) 'null)
  (send! (hasheq 'type "shutdown"))
  (expect! "bye"))

(delete-directory/files cfg-dir)

(test-case "settings over RPC: model aliases (add, replace, delete) and settings-created rules (save, bad regex, list, delete; builtin can't be deleted)"
  (define-values (send! expect! _p) (start))
  (expect! "ready")
  (send! (hasheq 'type "set_alias" 'name "fast" 'model "m-fast"))
  (expect! "ok")
  (send! (hasheq 'type "set_alias" 'name "strong" 'model "m-strong"))
  (expect! "ok")
  (send! (hasheq 'type "set_alias" 'name "fast" 'model "m-fast-2"))      ; 同名：原位替换
  (expect! "ok")
  (send! (hasheq 'type "list_aliases"))
  (define-values (al _a) (expect! "aliases"))
  (check-equal? (hash-ref al 'aliases) (list (hasheq 'name "fast" 'model "m-fast-2") (hasheq 'name "strong" 'model "m-strong")))
  (send! (hasheq 'type "set_alias" 'name "fast" 'model ""))              ; 空 = 删除
  (expect! "ok")
  (send! (hasheq 'type "set_alias" 'name "bad name!" 'model "x"))
  (expect! "error")
  (send! (hasheq 'type "list_aliases"))
  (define-values (al2 _a2) (expect! "aliases"))
  (check-equal? (map (lambda (a) (hash-ref a 'name)) (hash-ref al2 'aliases)) '("strong"))
  ;; 规则
  (send! (hasheq 'type "save_adaptation" 'name "gemma-terse" 'description "terse answers" 'model "gemma" 'system_append "Answer briefly."))
  (expect! "ok")
  (send! (hasheq 'type "save_adaptation" 'name "broken" 'model "(unclosed"))
  (define-values (err _e) (expect! "error"))
  (check-regexp-match #rx"not a valid regex" (hash-ref err 'message))
  (send! (hasheq 'type "list_adaptations"))
  (define-values (ad _d) (expect! "adaptations"))
  (define r (findf (lambda (x) (equal? (hash-ref x 'name) "gemma-terse")) (hash-ref ad 'rules)))
  (check-equal? (hash-ref r 'source) "settings")
  (check-equal? (hash-ref r 'system_append) "Answer briefly.")
  (check-equal? (hash-ref (hash-ref r 'match) 'model) "gemma")
  (check-false (findf (lambda (x) (equal? (hash-ref x 'name) "broken")) (hash-ref ad 'rules)))
  (send! (hasheq 'type "delete_adaptation" 'name "qwen3-no-think"))      ; 内置：不能删
  (expect! "error")
  (send! (hasheq 'type "delete_adaptation" 'name "gemma-terse"))
  (expect! "ok")
  (send! (hasheq 'type "list_adaptations"))
  (define-values (ad2 _d2) (expect! "adaptations"))
  (check-false (findf (lambda (x) (equal? (hash-ref x 'name) "gemma-terse")) (hash-ref ad2 'rules)))
  (check-not-false (findf (lambda (x) (equal? (hash-ref x 'name) "qwen3-no-think")) (hash-ref ad2 'rules))))
