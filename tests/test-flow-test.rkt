#lang tstring racket
;; test-flow-test.rkt — 工作区测试流程（test-flow.rkt，design-goalmode.md §12 T1）：格式与报错、往上找到项目根、三种输出解析、
;; 跑 + 报告、信任（内容变了要重新确认、yolo 不问）、两个工具、指令里的一节、goal 用流程当验收并出验收报告、先写验收的测试并进流程

(require rackunit racket/async-channel racket/file racket/string racket/list racket/system racket/port
         (file "../src/model.rkt") (file "../src/event.rkt") (file "../src/provider.rkt") (file "../src/tool.rkt")
         (file "../src/permission.rkt") (file "../src/loop.rkt") (file "../src/session.rkt") (file "../src/plugin.rkt")
         (file "../src/goal.rkt") (file "../src/test-flow.rkt") (file "../src/instructions.rkt"))

(define (put! dir rel s) (define p (build-path dir rel)) (make-parent-directory* p) (call-with-output-file p (lambda (o) (write-string s o)) #:exists 'truncate))
(define (git! dir . args) (parameterize ([current-output-port (open-output-nowhere)] [current-error-port (open-output-nowhere)])
                            (apply system* (find-executable-path "git") "-C" (path->string dir) "-c" "user.email=t@t" "-c" "user.name=t" args)))
(define home (make-temporary-file "pi2-tf-home-~a" 'directory))
(void (putenv "PI_CONFIG_HOME" (path->string home)))

(test-case "format: steps with #:parse / #:timeout, protect; errors say what is wrong"
  (define fl (parse-flow '(test-flow (name "p") (step unit "raco test tests" #:parse raco #:timeout 900) (step lint "make lint") (protect "tests/**" "run.sh")) "/r" "/r/.pi/tests.rktd" "x"))
  (check-equal? (map step-id (flow-steps fl)) '(unit lint))
  (check-equal? (map step-parse (flow-steps fl)) '(raco exit))
  (check-equal? (step-timeout (car (flow-steps fl))) 900)
  (check-equal? (flow-protect fl) '("tests/**" "run.sh"))
  (for ([bad (list '(tests (step a "x")) '(test-flow) '(test-flow (step a "x" #:parse cobol)) '(test-flow (step a "x") (step a "y")) '(test-flow (step "a" "x")))])
    (check-exn exn:fail? (lambda () (parse-flow bad "/r" "f" "x")))))

(test-case "found from a subdirectory up to the git root, not beyond"
  (define dir (make-temporary-file "pi2-tf-~a" 'directory))
  (put! dir "repo/.pi/tests.rktd" "(test-flow (step a \"true\"))") (make-directory* (build-path dir "repo" "src" "deep"))
  (git! (build-path dir "repo") "init" "-q")
  (check-equal? (find-flow-root (path->string (build-path dir "repo" "src" "deep"))) (path->string (simplify-path (build-path dir "repo"))))
  (put! dir ".pi/tests.rktd" "(test-flow (step a \"true\"))")                       ; git 根外面的不算
  (make-directory* (build-path dir "other" "x")) (git! (build-path dir "other") "init" "-q")
  (check-false (find-flow-root (path->string (build-path dir "other" "x"))))
  (put! dir "repo/.pi/tests.rktd" "(test-flow (step a))")
  (define-values (fl err) (load-flow (path->string (build-path dir "repo"))))
  (check-false fl) (check-regexp-match #rx"a step must be" err)
  (delete-directory/files dir))

(test-case "output parsing: raco test, python unittest, pytest"
  (define r (parse-output 'raco "FAILURE\nname:       check-equal?\nlocation:   tests/a-test.rkt:77:2\n--------------------\n1/12 test failures"))
  (check-equal? (list (hash-ref r 'failed) (hash-ref r 'total) (hash-ref r 'passed) (hash-ref r 'failures)) '(1 12 11 ("tests/a-test.rkt:77:2")))
  (check-equal? (hash-ref (parse-output 'raco "raco test: x\n799 tests passed") 'passed) 799)
  (define u (parse-output 'unittest "FAIL: test_b (test_x.T)\n----\nERROR: test_c (test_x.T)\n----\nRan 5 tests in 0.01s\n\nFAILED (failures=1, errors=1, skipped=1)"))
  (check-equal? (list (hash-ref u 'total) (hash-ref u 'failed) (hash-ref u 'skipped) (hash-ref u 'passed) (hash-ref u 'failures)) '(5 2 1 2 ("test_b (test_x.T)" "test_c (test_x.T)")))
  (define p (parse-output 'pytest "FAILED tests/test_a.py::test_x - assert 1 == 2\n========= 1 failed, 3 passed, 2 skipped in 0.12s ========="))
  (check-equal? (list (hash-ref p 'failed) (hash-ref p 'passed) (hash-ref p 'skipped) (hash-ref p 'failures)) '(1 3 2 ("tests/test_a.py::test_x"))))

(define (flow-repo!)
  (define dir (make-temporary-file "pi2-tf-~a" 'directory))
  (put! dir ".pi/tests.rktd" "(test-flow (name \"demo\") (step check \"grep -q READY app.txt\") (step unit \"sh tests/t.sh\" #:parse unittest) (protect \"app.spec\"))")
  (put! dir "tests/t.sh" "echo 'Ran 2 tests in 0.0s'; echo; echo OK")
  (git! dir "init" "-q") (git! dir "add" "-A") (git! dir "commit" "-q" "-m" "x")
  dir)

(test-case "trust: unknown content asks (always → remembered); changed content asks again; yolo never asks; nobody to ask → refused"
  (define dir (flow-repo!))
  (define-values (fl _e) (load-flow (path->string dir)))
  (check-regexp-match #rx"no one to ask" (ensure-trusted fl))
  (define asked (box 0))
  (check-eq? (ensure-trusted fl #:ask (lambda (t d) (set-box! asked (add1 (unbox asked))) 'yes)) #t)
  (check-false (trusted? fl))
  (check-eq? (ensure-trusted fl #:ask (lambda (t d) (set-box! asked (add1 (unbox asked))) 'always)) #t)
  (check-eq? (ensure-trusted fl #:ask (lambda (t d) (error "should not ask"))) #t)
  (put! dir ".pi/tests.rktd" "(test-flow (step check \"rm -rf /tmp/whatever\"))")
  (define-values (fl2 _e2) (load-flow (path->string dir)))
  (check-false (trusted? fl2))
  (check-regexp-match #rx"did not approve" (ensure-trusted fl2 #:ask (lambda (t d) 'no)))
  (check-eq? (ensure-trusted fl2 #:mode 'yolo) #t)
  (delete-directory/files dir))

(define (tool-named n) (findf (lambda (t) (equal? (tool-name t) n)) (make-test-flow-tools)))
(define (ctx-of dir [mode 'normal]) (tool-ctx (path->string dir) void (struct-copy config (default-config) [workdir (path->string dir)] [permission-mode mode])))

(test-case "tools: tests_run (some or all steps) and acceptance_report (always every step + changed test files) → structured report, recorded"
  (define dir (flow-repo!))
  (define recs (box '()))
  (define (run t input) (parameterize ([current-asker (lambda (_q) 'always)] [current-record-sink (lambda (k p) (set-box! recs (cons (cons k p) (unbox recs))))])
                          (tool-run (tool-named t) input (ctx-of dir))))
  (define o1 (run "tests_run" (hasheq 'steps '("unit"))))
  (check-false (tool-outcome-is-error? o1))
  (check-regexp-match #rx"✓ unit  \\$ sh tests/t.sh  \\(exit 0, [0-9.]+ s; 2 passed · 0 failed\\)" (tool-outcome-content o1))
  (check-false (regexp-match? #rx"check" (tool-outcome-content o1)))
  (check-regexp-match #rx"unknown step" (tool-outcome-content (run "tests_run" (hasheq 'steps '("nope")))))
  (put! dir "tests/t.sh" "exit 0")                                                ; 改了测试
  (define o2 (run "acceptance_report" (hasheq 'summary "made app ready")))
  (define txt (tool-outcome-content o2))
  (check-regexp-match #rx"^Acceptance report — test flow \"demo\"" txt)
  (check-regexp-match #rx"Claimed by the agent: made app ready" txt)
  (check-regexp-match #rx"✗ check" txt)                                           ; 全部步骤都跑了
  (check-regexp-match #rx"Test / protected files with uncommitted changes \\(git status; 1\\): M tests/t.sh" txt)
  (check-regexp-match #rx"Result: FAIL \\(1 of 2 steps failed\\)" txt)
  (check-regexp-match #rx"FAILS: the task is not complete" txt)
  (check-equal? (map (lambda (r) (hash-ref (cdr r) 'kind)) (filter (lambda (r) (eq? (car r) 'tests)) (reverse (unbox recs)))) '("run" "acceptance"))
  (define empty (make-temporary-file "pi2-tf-~a" 'directory))
  (check-regexp-match #rx"no test flow" (tool-outcome-content (tool-run (tool-named "tests_run") (hasheq) (ctx-of empty))))
  (check-regexp-match #rx"not trusted yet" (tool-outcome-content (parameterize ([current-asker #f])
                                                                    (put! dir ".pi/tests.rktd" "(test-flow (step x \"true\"))")
                                                                    (tool-run (tool-named "tests_run") (hasheq) (ctx-of dir)))))
  (delete-directory/files dir) (delete-directory/files empty))

(test-case "instructions: the flow appears as its own section (steps, when to run, report before claiming done)"
  (define dir (flow-repo!))
  (define segs (collect-instructions (path->string dir) #:home #f))
  (check-equal? (map (lambda (s) (hash-ref s 'kind)) segs) '("tests"))
  (define add (instructions-addendum segs))
  (check-regexp-match #rx"### Workspace test flow" add)
  (check-regexp-match #rx"check: \\$ grep -q READY app.txt" add)
  (check-regexp-match #rx"call acceptance_report" add)
  (delete-directory/files dir))

;; ---------------------------------------------------------------- goal 模式
(define (scripted #:worker worker #:spec [spec (lambda () "{}")])
  (provider "s" (lambda (msgs _t)
                  (define sys (or (config-system-prompt (current-config)) ""))
                  (define ch (make-async-channel))
                  (define text (cond [(string-prefix? sys "You are an independent reviewer") "{\"verdict\": \"done\", \"findings\": []}"]
                                     [(string-prefix? sys "You write acceptance tests") (spec)]
                                     [else (worker)]))
                  (async-channel-put ch (evt:message (now-ms) (text-msg 'assistant text)))
                  (async-channel-put ch (evt:turn-end (now-ms) "stop" (usage 1 1)))
                  ch) void))
(define (goal! dir prov until #:approve [approve (lambda (t d) 'always)])
  (define cfg (struct-copy config (default-config) [workdir (path->string dir)] [permission-mode 'normal]))
  (define host (make-plugin-host))
  (define d (make-deps #:provider prov #:registry (make-registry '()) #:bus (make-bus) #:policy (make-policy cfg) #:plugin-host host))
  (define sess (session-open! (build-path (make-temporary-file "pi2-tf-s-~a" 'directory) "s.rktd") cfg))
  (define log (box '()))
  (run-goal! d (make-initial-state cfg) sess "make the app ready" until 5 host #:approve approve #:emit (lambda (s) (set-box! log (cons s (unbox log)))))
  (session-close! sess)
  (string-join (reverse (unbox log)) "\n"))

(test-case "goal: no command given → the workspace flow is the acceptance; done → an acceptance report from this run; the flow file is protected"
  (define dir (flow-repo!))
  (define n (box 0))
  (define log (goal! dir (scripted #:worker (lambda ()
                                               (set-box! n (add1 (unbox n)))
                                               (when (= (unbox n) 1) (put! dir ".pi/tests.rktd" "(test-flow (step check \"true\"))"))   ; 想放宽验收
                                               (put! dir "app.txt" "READY") "working"))
                     '()))
  (check-regexp-match #rx"guard: restored 1 protected file\\(s\\): .pi/tests.rktd" log)
  (check-regexp-match #rx"Acceptance report — test flow \"demo\"" log)
  (check-regexp-match #rx"✓ check  \\$ grep -q READY app.txt" log)
  (check-regexp-match #rx"DONE ✓" log)
  (delete-directory/files dir))

(test-case "goal: no flow and no command → tests written first → approved → saved into .pi/tests.rktd (shared) → done"
  (define dir (make-temporary-file "pi2-tf-~a" 'directory))
  (git! dir "init" "-q")
  (define log (goal! dir (scripted #:worker (lambda () (put! dir "app.txt" "READY") "working")
                                   #:spec (lambda () "{\"files\": [{\"path\": \"tests/acc.sh\", \"content\": \"grep -q READY app.txt\"}], \"command\": \"sh tests/acc.sh\"}"))
                     '()))
  (check-regexp-match #rx"added step goal-1 to .pi/tests.rktd" log)
  (define-values (fl _e) (load-flow (path->string dir)))
  (check-equal? (map step-cmd (flow-steps fl)) '("sh tests/acc.sh"))
  (check-true (trusted? fl))                                                       ; 用户刚确认过：新流程直接信任
  (check-regexp-match #rx"DONE ✓" log)
  (delete-directory/files dir))

(delete-directory/files home)

(test-case "T2 via run-rpc!: view, run (history), the model proposes a change → listed → reject / apply (written + trusted) → stale proposal = conflict"
  (local-require json (file "../src/rpc.rkt"))
  (define dir (flow-repo!))
  (define script (box '()))
  (define prov (provider "s" (lambda (msgs _t)
                               (define ch (make-async-channel))
                               (define lastm (last msgs))
                               (define tr? (for/or ([b (message-blocks lastm)]) (tool-result-block? b)))
                               (define call (and (not tr?) (pair? (unbox script)) (car (unbox script))))
                               (cond [call (set-box! script (cdr (unbox script)))
                                           (async-channel-put ch (evt:message (now-ms) (message 'assistant (list (tool-use-block "c1" (car call) (cdr call))))))
                                           (async-channel-put ch (evt:turn-end (now-ms) "tool_calls" (usage 1 1)))]
                                     [else (async-channel-put ch (evt:message (now-ms) (text-msg 'assistant "ok")))
                                           (async-channel-put ch (evt:turn-end (now-ms) "stop" (usage 1 1)))])
                               ch) void))
  (define cfg (struct-copy config (default-config) [workdir (path->string dir)] [permission-mode 'yolo]))
  (define sdir (make-temporary-file "pi2-tf-sess-~a" 'directory))
  (define sess (session-open! (fresh-session-path (path->string sdir)) cfg))
  (define host (make-plugin-host))
  (define d (make-deps #:provider prov #:registry (make-registry (list* (make-test-flow-tools))) #:bus (make-bus) #:policy (make-policy cfg) #:plugin-host host))
  (define-values (in-r in-w) (make-pipe)) (define-values (out-r out-w) (make-pipe))
  (thread (lambda () (parameterize ([current-input-port in-r] [current-output-port out-w])
                       (run-rpc! d (make-initial-state cfg) sess #:plugin-host host #:fetch-models (lambda (_e) #f)))
            (close-output-port out-w)))
  (define (send! j) (write-string (jsexpr->string j) in-w) (newline in-w) (flush-output in-w))
  (define (read-type type)
    (let loop () (define l (sync/timeout 20 (read-line-evt out-r 'linefeed)))
      (unless (string? l) (error 'read-type "timeout waiting for ~a" type))
      (define j (string->jsexpr l)) (if (equal? (hash-ref j 'type #f) type) j (loop))))
  (read-type "session")
  (send! (hasheq 'type "test_flow"))
  (define v1 (read-type "test_flow"))
  (check-equal? (map (lambda (s) (hash-ref s 'id)) (hash-ref v1 'steps)) '("check" "unit"))
  (check-false (hash-ref v1 'trusted))
  (send! (hasheq 'type "test_flow_run" 'steps '("unit")))
  (define r (read-type "test_flow_result"))
  (check-true (hash-ref r 'ok))
  (check-equal? (hash-ref (car (hash-ref r 'results)) 'passed) 2)
  (send! (hasheq 'type "test_flow"))
  (check-equal? (length (hash-ref (read-type "test_flow") 'history)) 1)
  ;; 模型提议：多一步
  (define new-content "(test-flow (name \"demo\") (step check \"grep -q READY app.txt\") (step unit \"sh tests/t.sh\" #:parse unittest) (step lint \"true\") (protect \"app.spec\"))")
  (set-box! script (list (cons "tests_propose" (hasheq 'content "(test-flow (step x))" 'reason "bad")) (cons "tests_propose" (hasheq 'content new-content 'reason "add a lint step"))))
  (send! (hasheq 'type "prompt" 'text "propose")) (read-type "turn_complete")
  (send! (hasheq 'type "prompt" 'text "propose again")) (read-type "turn_complete")
  (send! (hasheq 'type "test_flow"))
  (define ps (hash-ref (read-type "test_flow") 'proposals))
  (check-equal? (map (lambda (p) (hash-ref p 'reason)) ps) '("add a lint step"))          ; 无效的那个没进提议
  (check-regexp-match #rx"\\+.*lint" (hash-ref (hash-ref (car ps) 'diff) 'text))
  (check-equal? (length (filter (lambda (s) (equal? (hash-ref s 'id) "lint")) (hash-ref v1 'steps))) 0)   ; 还没生效
  ;; 批准 → 写进文件、信任
  (send! (hasheq 'type "test_flow_decide" 'id (hash-ref (car ps) 'id) 'decision "apply"))
  (check-equal? (hash-ref (read-type "ok") 'decision) "applied")
  (define v2 (read-type "test_flow"))
  (check-equal? (map (lambda (s) (hash-ref s 'id)) (hash-ref v2 'steps)) '("check" "unit" "lint"))
  (check-true (hash-ref v2 'trusted))
  (check-equal? (hash-ref v2 'proposals) '())
  ;; 过期的提议（文件已经变了）→ 冲突
  (set-box! script (list (cons "tests_propose" (hasheq 'content "(test-flow (step only \"true\"))" 'reason "simplify"))))
  (send! (hasheq 'type "prompt" 'text "propose 3")) (read-type "turn_complete")
  (put! dir ".pi/tests.rktd" "(test-flow (step changed \"true\"))")
  (send! (hasheq 'type "test_flow"))
  (define p3 (car (hash-ref (read-type "test_flow") 'proposals)))
  (send! (hasheq 'type "test_flow_decide" 'id (hash-ref p3 'id) 'decision "apply"))
  (check-regexp-match #rx"changed after this proposal" (hash-ref (read-type "error") 'message))
  (send! (hasheq 'type "test_flow_decide" 'id (hash-ref p3 'id) 'decision "reject"))
  (check-equal? (hash-ref (read-type "ok") 'decision) "rejected")
  (send! (hasheq 'type "shutdown")) (void (read-type "bye"))
  (delete-directory/files dir) (delete-directory/files sdir))
